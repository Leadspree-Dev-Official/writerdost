{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "writerdost",
	"main": ".open-next/worker.js",
	"compatibility_date": "2024-12-30",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "writerdost"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"routes": [
		{
			"pattern": "writerdost.leadspree.in",
			"custom_domain": true
		}
	],
	"vars": {
		"WRITERDOST_SITE_URL": "https://writerdost.leadspree.in",
		"WRITERDOST_APP_NAME": "Writerdost AI",
		"WRITERDOST_PLATFORM_PROVIDER": "openai",
		"WRITERDOST_PLATFORM_MODEL": "gpt-4o-mini"
	}
}
