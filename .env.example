# ---------------------------------------------------------------------------
# Writerdost AI — environment
#
# The manual app (ebooks, rewrite, blog draft, exports) needs none of these:
# it runs on BYO API settings held in the browser. Everything below is for
# BLOG AUTOMATION, which runs on the server on a schedule.
# ---------------------------------------------------------------------------

# --- Supabase (required for scheduled automation) --------------------------
# Create a project at supabase.com, then apply
# supabase/migrations/0001_automation.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key. Server only — bypasses row level security. Never expose
# this to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Credential encryption (required to store CMS tokens) ------------------
# 32 bytes, base64 or hex. Generate with:  openssl rand -base64 32
# Changing this makes every stored credential unreadable.
WRITERDOST_ENCRYPTION_KEY=

# --- Scheduler authentication (required for scheduled automation) ----------
# Shared secret between pg_cron and /api/automations/tick.
# Generate with:  openssl rand -hex 32
# Store the same value in Supabase Vault as 'cron_secret' (see the migration).
WRITERDOST_CRON_SECRET=

# --- Outbound AI guard (optional) ------------------------------------------
# Extra hosts allowed for the `custom` / `ollama_cloud` providers.
WRITERDOST_ALLOWED_AI_HOSTS=
# Set to "false" to block localhost AI endpoints (Ollama).
WRITERDOST_ALLOW_LOCAL_AI=

# --- Platform defaults (not yet used) --------------------------------------
WRITERDOST_PLATFORM_PROVIDER=openai
WRITERDOST_PLATFORM_MODEL=gpt-4o-mini
WRITERDOST_PLATFORM_API_KEY=
WRITERDOST_SITE_URL=http://localhost:3000
WRITERDOST_APP_NAME=Writerdost AI
