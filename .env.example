# ---------------------------------------------------------------------------
# Writerdost AI — environment
#
# Appwrite is REQUIRED. It holds the accounts people sign in with, and the blog
# campaigns the scheduler runs. Ebook drafting still spends a BYO AI key held
# in the browser, but there is no signing in without Appwrite.
# ---------------------------------------------------------------------------

# --- Appwrite 2.0 (required) -----------------------------------------------
# Create a project at cloud.appwrite.io, then apply the schema:
#   npm run appwrite:setup
# See appwrite/README.md for the walkthrough.
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
# Server only — an API key ignores row permissions the way a service role does.
# Never expose it to the browser and never prefix it with NEXT_PUBLIC_.
# Scopes needed:
#   databases.read, databases.write  — the campaign tables
#   users.read,     users.write      — the admin screen, and the `admin` label
#                                      that grants the administrator role
APPWRITE_API_KEY=
# The database the tables live in. Created by the setup script.
APPWRITE_DATABASE_ID=writerdost

# Required: the browser talks to Appwrite directly for sign-in. Safe to expose
# — these two are public by design. Usually the same values as above.
NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# --- Credential encryption (required to store CMS and AI keys) -------------
# 32 bytes, base64 or hex. Generate with:  openssl rand -base64 32
# Changing this makes every stored credential unreadable.
WRITERDOST_ENCRYPTION_KEY=

# --- Scheduler authentication (required for scheduled automation) ----------
# Shared secret between the Appwrite Function and /api/automations/tick.
# Generate with:  openssl rand -hex 32
# Set the same value as a variable on the automation-tick function.
WRITERDOST_CRON_SECRET=

# --- Outbound AI guard (optional) ------------------------------------------
# Extra hosts allowed for the `custom` / `ollama_cloud` providers.
WRITERDOST_ALLOWED_AI_HOSTS=
# Set to "false" to block localhost AI endpoints (Ollama).
WRITERDOST_ALLOW_LOCAL_AI=

# --- Platform defaults (not yet used) --------------------------------------
WRITERDOST_PLATFORM_PROVIDER=openai
WRITERDOST_PLATFORM_MODEL=gpt-4o-mini
WRITERDOST_PLATFORM_API_KEY=
WRITERDOST_SITE_URL=http://localhost:3000
WRITERDOST_APP_NAME=Writerdost AI
