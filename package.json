{
  "name": "writerdost-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=3072' next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview:worker": "opennextjs-cloudflare preview",
    "deploy:worker": "opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "appwrite:setup": "node appwrite/setup.mjs",
    "appwrite:grant-admin": "node appwrite/grant-admin.mjs",
    "test:e2e:auth": "playwright test --project=chromium e2e/authenticated.spec.ts",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "secrets:reencrypt": "node scripts/reencrypt-secrets.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-bubble-menu": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@types/pdf-parse": "^1.1.5",
    "appwrite": "^27.0.0",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.0",
    "docx": "^9.6.1",
    "dompurify": "^3.4.17",
    "framer-motion": "^12.38.0",
    "idb-keyval": "^6.3.0",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.12.0",
    "next": "^16.4.6",
    "node-appwrite": "^29.0.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.4.0",
    "rate-limiter-flexible": "^11.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.18.1",
    "tailwind-merge": "^3.5.0",
    "undici": "^8.12.3",
    "wrangler": "^4.162.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  }
}
